    "php": "<?php\n$input = isset($_GET['q']) ? $_GET['q'] : 'movie.swf';\n?>\n<!DOCTYPE html>\n<html>\n<body>\n    <h3>URL - Param SRC</h3>\n    <p>The <code>q</code> parameter is assigned to the <code>value</code> of a <code>&lt;param name=\"src\"&gt;</code> tag inside an <code>&lt;object&gt;</code> element.</p>\n    <p>Param: <code>?q=</code></p>\n\n    <div style=\"margin: 20px 0; padding: 20px; border: 1px dashed #555; border-radius: 8px; background: rgba(255,255,255,0.02);\">\n        <p style=\"color: #888; font-size: 0.85em; margin-bottom: 10px;\">⬇️ Object with param:</p>\n        <!-- INJECTION POINT: param value -->\n        <object>\n            <param name=\"src\" value=\"<?php echo $input; ?>\">\n        </object>\n        <p>Param value: <code><?php echo htmlspecialchars($input, ENT_QUOTES, 'UTF-8'); ?></code></p>\n    </div>\n</body>\n</html>",
